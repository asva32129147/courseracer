rules_version='2';service cloud.firestore{match /databases/{database}/documents{function signedIn(){return request.auth!=null;}function admin(){return signedIn()&&request.auth.uid=="RcpTC3K2OpM5MfJDoNhOZhAx0K93";}match /users/{uid}{allow read:signedIn();allow create:signedIn()&&request.auth.uid==uid;allow update:if admin()||(signedIn()&&request.auth.uid==uid&&request.resource.data.role==resource.data.role);allow delete:if admin();}match /progress/{id}{allow read:signedIn();allow write:if admin();allow delete:if admin();}}}
